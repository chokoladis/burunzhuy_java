<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006" author="igor">
        <createTable tableName="ideas_attaches">
            <column name="idea_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="file_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
                tableName="ideas_attaches"
                columnNames="idea_id, file_id"
                constraintName="pk_ideas_attaches"/>

        <addForeignKeyConstraint
                baseTableName="ideas_attaches"
                baseColumnNames="idea_id"
                referencedTableName="ideas"
                referencedColumnNames="id"
                constraintName="fk_ideas_attaches_idea"/>

        <addForeignKeyConstraint
                baseTableName="ideas_attaches"
                baseColumnNames="file_id"
                referencedTableName="files"
                referencedColumnNames="id"
                constraintName="fk_ideas_attaches_file"/>
    </changeSet>
</databaseChangeLog>