<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002" author="igor">
        <createTable tableName="roles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValue="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>
        <!--todo сделать добавление через админку + выбирать точки доступа-->
        <insert tableName="roles">
            <column name="role" value="seller"></column>
        </insert>
        <insert tableName="roles">
            <column name="role" value="buyer"></column>
        </insert>
        <insert tableName="roles">
            <column name="role" value="manager"></column>
        </insert>
        <insert tableName="roles">
            <column name="role" value="admin"></column>
        </insert>
    </changeSet>
</databaseChangeLog>