<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="007" author="igor">
        <createTable tableName="auctions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="idea_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="buyer_id" type="BIGINT"/>

            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="finished_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="auctions"
                baseColumnNames="idea_id"
                referencedTableName="ideas"
                referencedColumnNames="id"
                constraintName="fk_auctions_idea"/>
        <addForeignKeyConstraint
                baseTableName="auctions"
                baseColumnNames="buyer_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_auctions_buyer"/>

        <createTable tableName="auctions_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="auction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="buyer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="bid" type="NUMERIC(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="auctions_history"
                baseColumnNames="auction_id"
                referencedTableName="auctions"
                referencedColumnNames="id"
                constraintName="fk_auctions_history_auction"/>
        <addForeignKeyConstraint
                baseTableName="auctions_history"
                baseColumnNames="buyer_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_auctions_history_buyer"/>
    </changeSet>
</databaseChangeLog>