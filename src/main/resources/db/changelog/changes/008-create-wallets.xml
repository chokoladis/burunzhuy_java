<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="008" author="igor">
        <createTable tableName="wallets">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="balance" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>

            <column name="currency" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="wallets"
                baseColumnNames="owner_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_wallets_user"/>

        <createTable tableName="wallet_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wallet_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="auction_id" type="BIGINT"/>

            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="wallet_history"
                baseColumnNames="wallet_id"
                referencedTableName="wallets"
                referencedColumnNames="id"
                constraintName="fk_wallet_history_wallet"/>
        <addForeignKeyConstraint
                baseTableName="wallet_history"
                baseColumnNames="auction_id"
                referencedTableName="auctions"
                referencedColumnNames="id"
                constraintName="fk_wallet_history_auction"/>
    </changeSet>
</databaseChangeLog>