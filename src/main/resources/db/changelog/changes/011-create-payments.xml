<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="011" author="igor">
        <createTable tableName="payment_systems">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(60)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)"/>

            <column name="status" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="extra" type="jsonb"/>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="updated_at" type="TIMESTAMP" />
        </createTable>

        <createTable tableName="payment_invoices">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="payment_system_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="wallet_history_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="amount" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="actually_paid" type="NUMERIC(12,2)"/>

            <column name="status" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>

            <column name="extra" type="jsonb">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
            <column name="expiration_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="payment_invoices"
                baseColumnNames="wallet_history_id"
                referencedTableName="wallet_history"
                referencedColumnNames="id"
                constraintName="fk_payment_invoices_wallet_hisotry"/>

        <addForeignKeyConstraint
                baseTableName="payment_invoices"
                baseColumnNames="payment_system_id" constraintName="fk_payment_invoices_payment_system"
                 referencedTableName="payment_systems"
                 referencedColumnNames="id"/>

        <insert tableName="payment_systems">
            <column name="name">Nowpayment</column>
            <column name="code">nowpayment</column>
            <column name="description">Оплата переводом крипты</column>
            <column name="extra">{"img": "/uploads/main/pay/NOWPayments.svg"}</column>
            <column name="status">active</column>
        </insert>

    </changeSet>
</databaseChangeLog>