<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004" author="igor">
        <createTable tableName="files">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="original_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="memo_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="path" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="entity" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="purpose" type="VARCHAR(50)"/>
            <!--nullable ?-->
            <!--mb составной по полям (entity, entity_id, purpose ?-->
            <column name="created_at" type="TIMESTAMP" defaultValue="NOW()"/>
        </createTable>

        <createIndex indexName="idx_entity_entity_id" tableName="files">
            <column name="entity"/>
            <column name="entity_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>